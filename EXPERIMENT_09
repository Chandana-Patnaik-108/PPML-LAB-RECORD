        "# 1. WAP to Create and Work with a Pandas Series.\n",
        "import pandas as pd\n",
        "\n",
        "data = [10, 20, 30]\n",
        "labels = ['a', 'b', 'c']\n",
        "\n",
        "series = pd.Series(data, index=labels)\n",
        "\n",
        "print(\"Pandas Series:\")\n",
        "print(series)\n",
        "\n",
        "print(\"Value at label 'b':\", series['b'])"
      ]
