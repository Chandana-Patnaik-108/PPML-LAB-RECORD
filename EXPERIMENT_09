        "\n",
        "df_csv = pd.read_csv('sample.csv')\n",
        "\n",
        "print(\"DataFrame from CSV:\")\n",
        "print(df_csv)\n",
        "\n",
        "df_json = pd.read_json('sample.json')\n",
        "\n",
        "print(\"\\nDataFrame from JSON:\")\n",
        "print(df_json)"
