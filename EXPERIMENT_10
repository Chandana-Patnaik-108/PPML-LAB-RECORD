        "# 3. WAP to Draw Histograms and Box Plots\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Histogram\n",
        "data = [22, 87, 5, 43, 56, 73, 55, 54, 11, 20, 51, 5]\n",
