        "plt.hist(data, bins=5, color='purple', label=\"Histogram Data\")\n",
        "plt.title(\"Histogram\")\n",
        "plt.xlabel(\"Bins\")\n",
        "plt.ylabel(\"Frequency\")\n",
        "plt.legend()\n",
        "plt.show()\n",
        "\n",
        "# Box Plot\n",
        "data = [7, 8, 5, 6, 9, 10, 15, 20, 21]\n",
        "\n",
        "plt.boxplot(data)\n",
        "plt.title(\"Box Plot\")\n",
        "plt.ylabel(\"Values\")\n",
        "plt.show()"
