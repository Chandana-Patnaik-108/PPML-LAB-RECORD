        "# 1. WAP to Plot a Simple Graph Using plot()\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "x = [1, 2, 3, 4]\n",
        "y = [10, 20, 25, 30]\n",
        "\n",
        "plt.plot(x, y)\n",
        "\n",
        "plt.title(\"Simple Line Plot\")\n",
        "plt.plot(x, y, linestyle='--', color='r', marker='o', label=\"Data Line\")\n",
        "\n",
        "plt.xlabel(\"X-axis\")\n",
        "plt.ylabel(\"Y-axis\")\n",
        "plt.legend()\n",
        "plt.grid()\n",
        "\n",
        "plt.show()"
      ]
