        "# 1. WAP to print twin prime numbers between 1 to N.\n",
        "n = int(input(\"Enter the value of N: \"))\n",
        "\n",
        "for i in range(2, n):\n",
        "    prime1 = True\n",
        "    prime2 = True\n",
        "\n",
        "    for j in range(2, i):\n",
        "        if i % j == 0:\n",
        "            prime1 = False\n",
        "            break\n",
        "\n",
        "    for j in range(2, i + 2):\n",
        "        if (i + 2) % j == 0:\n",
        "            prime2 = False\n",
        "            break\n",
        "\n",
        "    if prime1 and prime2 and i + 2 <= n:\n",
        "        print(i, i + 2)"
      ]
    },
