        "# 4. WAP to check whether the string is symmetrical or palindrome.\n",
        "str1 = input(\"Enter a string: \")\n",
        "\n",
        "mid = len(str1) // 2\n",
        "\n",
        "if len(str1) % 2 == 0:\n",
        "    first = str1[:mid]\n",
        "    second = str1[mid:]\n",
        "else:\n",
        "    first = str1[:mid]\n",
        "    second = str1[mid+1:]\n",
        "\n",
        "if first == second:\n",
        "    print(\"Symmetrical String\")\n",
        "else:\n",
        "    print(\"Not a Symmetrical String\")\n",
        "\n",
        "if str1 == str1[::-1]:\n",
        "    print(\"Palindrome String\")\n",
        "else:\n",
        "    print(\"Not a Palindrome String\")"
      ],
