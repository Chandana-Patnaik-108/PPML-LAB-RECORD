        "# 6. WAP to enter a 3 digit number and print all the prime factors of the number.\n",
        "num = int(input(\"Enter a 3-digit number: \"))\n",
        "\n",
        "print(\"Prime factors are:\")\n",
        "\n",
        "for i in range(2, num + 1):\n",
        "    if num % i == 0:\n",
        "        prime = True\n",
        "\n",
        "        for j in range(2, i):\n",
        "            if i % j == 0:\n",
        "                prime = False\n",
        "                break\n",
        "\n",
        "        if prime:\n",
        "            print(i)"
      ],
