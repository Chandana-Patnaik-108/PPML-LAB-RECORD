        "# 3. WAP to enter a number and check wheather it is a palindrome number or not.\n",
        "num = int(input(\"Enter a number: \"))\n",
        "\n",
        "temp = num\n",
        "rev = 0\n",
        "\n",
        "while num > 0:\n",
        "    digit = num % 10\n",
        "    rev = rev * 10 + digit\n",
        "    num = num // 10\n",
        "\n",
        "if temp == rev:\n",
        "    print(\"Palindrome Number\")\n",
        "else:\n",
        "    print(\"Not a Palindrome Number\")"
      ],
