        "print(\"Sum:\", arr.sum())\n",
        "print(\"Product:\", arr.prod())\n",
        "print(\"Mean:\", arr.mean())\n",
        "\n",
        "# Broadcasting\n",
        "print(\"Broadcasted result:\", arr + 5)"
