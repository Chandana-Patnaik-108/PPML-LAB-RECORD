    {
      "cell_type": "code",
      "source": [
        "# WAP for NumPy Array Properties and Functions.\n",
        "import numpy as np\n",
        "\n",
        "# Creating arrays using NumPy functions\n",
        "ones_array = np.ones((2, 3))\n",
        "zeros_array = np.zeros((2, 3))\n",
        "empty_array = np.empty((2, 3))\n",
        "\n",
        "print(\"Ones:\\n\", ones_array)\n",
        "print(\"Zeros:\\n\", zeros_array)\n",
        "print(\"Empty:\\n\", empty_array)\n",
        "\n",
        "# Array properties\n",
        "arr = np.array([[1, 2, 3], [4, 5, 6]])\n",
        "\n",
        "print(\"Shape of array:\", arr.shape)\n",
        "print(\"Size of array:\", arr.size)\n",
        "print(\"Dimensions:\", arr.ndim)\n",
        "print(\"Data type:\", arr.dtype)\n",
        "\n",
        "# Reshaping an array\n",
        "reshaped = arr.reshape(3, 2)\n",
        "print(\"Reshaped array:\\n\", reshaped)\n",
        "\n",
        "# Copy and View\n",
        "arr1 = np.array([1, 2, 3])\n",
        "\n",
        "copy_arr1 = arr1.copy()\n",
        "view_arr1 = arr1.view()\n",
        "\n",
        "print(\"Original:\", arr1)\n",
        "print(\"Copy:\", copy_arr1)\n",
        "print(\"View:\", view_arr1)\n",
        "\n",
        "# Concatenation\n",
        "arr2 = np.array([1, 2])\n",
        "arr3 = np.array([3, 4])\n",
        "\n",
        "concatenated = np.concatenate((arr2, arr3))\n",
        "print(\"Concatenated array:\", concatenated)\n",
        "\n",
        "# Sorting\n",
        "arr4 = np.array([5, 2, 9, 1])\n",
        "print(\"Sorted array:\", np.sort(arr4))"
