      "cell_type": "code",
      "source": [
        "# 4. WAP to enter a set and copy the content of the set into a new set one element at a time.\n",
        "s1 = eval(input(\"Enter a set: \"))\n",
        "\n",
        "s2 = set()\n",
        "\n",
        "for i in s1:\n",
        "    s2.add(i)\n",
        "\n",
        "print(\"Original set:\", s1)\n",
        "print(\"Copied set:\", s2)"
      ],
      "metadata": {
